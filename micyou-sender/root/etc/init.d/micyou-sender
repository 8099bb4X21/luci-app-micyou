#!/bin/sh /etc/rc.common
# MicYou 无线麦克风发送端（E5 麦克风 -> PC 的 MicYou 服务端）。
#
# 配置：/etc/config/micyou  [micyou.main]
#   server          PC 端服务端地址（必填，IPv4）
#   port            TCP 控制端口（默认 8554，UDP = 端口+1）
#   device          ALSA 采集设备（默认 hw:0,0）
#
# 手动控制：micyou-ctl connect|disconnect|status|autostart on|off
# 开机自启：micyou-ctl autostart on   （等价 /etc/init.d/micyou-sender enable）
#
# 掉线（PC 服务端未开、网络抖动）时由 procd 自动重启重试，等价于断线重连。

START=95
STOP=10
USE_PROCD=1

SENDER=/usr/bin/micyou_sender.py

start_service() {
	local server port device
	config_load micyou
	config_get server main server ''
	config_get port main port '8554'
	config_get device main device 'hw:0,0'

	if [ -z "$server" ]; then
		echo "micyou-sender: 未设置服务器地址（LuCI: 服务 -> 无线麦克风；或 micyou-ctl）" >&2
		return 1
	fi
	if [ ! -f "$SENDER" ]; then
		echo "micyou-sender: 缺少发送端 $SENDER" >&2
		return 1
	fi

	# 采集增益（配置里指定时才动）：重启后混音器会回默认，所以每次启动都应用
	local gain
	config_get gain main gain ''
	if [ -n "$gain" ]; then
		/usr/bin/micyou-ctl gain "$gain" >/dev/null 2>&1 || true
	fi

	procd_open_instance
	procd_set_param command /usr/bin/python3 "$SENDER" \
		--host "$server" --port "$port" --source arecord --device "$device"
	# 异常退出后自动重启：阈值 3600s / 退避 5s / **无限重试**（PC 端没开时会一直重试，
# 相当于断线自动重连；每次只是一次失败的 TCP 连接，开销可忽略）
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# 说明：故意不注册 procd_add_reload_trigger micyou。
# 连接键/断开键也存放在同一个 UCI 配置里，若整包变更都触发重启，
# 改一次按键绑定就会把正在推流的会话打断一次，得不偿失。
# 改 server/port/device 后需要重新连接：LuCI 保存时会自动重连；
# 命令行则 `uci commit micyou && micyou-ctl connect`。
reload_service() {
	stop
	start
}