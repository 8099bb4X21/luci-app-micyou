#!/bin/sh /etc/rc.common
# MicYou 定时连接/断开：按 /etc/config/micyou 的 main.sched_connect / sched_disconnect
# （HH:MM，空 = 不启用）执行。空闲时它只是“睡到下个事件”，CPU 占用可忽略。
#
# 手动控制：/etc/init.d/micyou-schedule start|stop|enable|disable

START=96
STOP=11
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/micyou-schedule.py
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}